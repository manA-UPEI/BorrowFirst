{
  "name": "borrowfirst",
  "version": "1.0.0",
  "description": "BorrowFirst local lending app",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.mjs",
    "start:legacy": "node server.js",
    "seed:demo": "node scripts/seedDemo.js",
    "test": "npm run build && node --test",
    "security:check": "npm test && npm audit --omit=dev"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.1",
    "express": "^4.22.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.10",
    "jsdom": "^26.1.0",
    "pg-mem": "^3.0.14",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "qs": "6.14.2"
  }
}
