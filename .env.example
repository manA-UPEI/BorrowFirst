NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=0
SESSION_NAME=borrowfirst.sid
SESSION_SECRET=replace-with-a-long-random-secret
# Required in production. In non-production, if omitted, the app falls back to an in-memory
# Postgres-compatible database for tests and temporary local development.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/borrowfirst

# Option 1: SMTP (recommended for this project)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
OTP_FROM_EMAIL=BorrowFirst <your-email@gmail.com>

# Option 2: Resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# OTP_FROM_EMAIL=BorrowFirst <no-reply@yourdomain.com>

# Optional override for transaction handoff code derivation
# TRANSACTION_CODE_SECRET=replace-with-a-different-long-random-secret

# Cloudinary image storage
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
